rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helper Primitives ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ramprakashshah8236@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'role', 'createdAt']) &&
             data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() <= 254 &&
             data.role is string && (
               data.role in ['system_admin', 'regional_director', 'hospital_logistics_lead', 'clinical_pharmacist', 'supply_analyst']
             ) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('assignedHospitalId' in data) || (data.assignedHospitalId is string && data.assignedHospitalId.size() <= 64)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['logId', 'timestamp', 'userId', 'userEmail', 'userRole', 'action', 'resource', 'status']) &&
             data.logId is string && isValidId(data.logId) &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.userId is string && isValidId(data.userId) &&
             data.userEmail is string && data.userEmail.size() <= 254 &&
             data.userRole is string && data.userRole.size() <= 64 &&
             data.action is string && data.action.size() <= 64 &&
             data.resource is string && data.resource.size() <= 128 &&
             data.status is string && (data.status in ['SUCCESS', 'DENIED', 'WARNING']) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2048));
    }

    function isValidRedistribution(data) {
      return data.keys().hasAll(['transferId', 'sourceHospitalId', 'targetHospitalId', 'skuId', 'quantity', 'urgency', 'status', 'createdAt']) &&
             data.transferId is string && isValidId(data.transferId) &&
             data.sourceHospitalId is string && isValidId(data.sourceHospitalId) &&
             data.targetHospitalId is string && isValidId(data.targetHospitalId) &&
             data.skuId is string && isValidId(data.skuId) &&
             data.quantity is number && data.quantity > 0 && data.quantity <= 1000000 &&
             data.urgency is string && (data.urgency in ['CRITICAL', 'HIGH', 'ROUTINE']) &&
             data.status is string && (data.status in ['PROPOSED', 'APPROVED', 'DISPATCHED', 'DELIVERED', 'CANCELLED']) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 128)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidCrisisEvent(data) {
      return data.keys().hasAll(['scenarioId', 'initiatedBy', 'timestamp']) &&
             data.scenarioId is string && isValidId(data.scenarioId) &&
             data.initiatedBy is string && isValidId(data.initiatedBy) &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             (!('diseaseDemandIncreasePct' in data) || data.diseaseDemandIncreasePct is number) &&
             (!('supplyDisruptionPct' in data) || data.supplyDisruptionPct is number) &&
             (!('portDisruptionPct' in data) || data.portDisruptionPct is number) &&
             (!('affectedHospitalCount' in data) || data.affectedHospitalCount is number) &&
             (!('projectedStockoutsCount' in data) || data.projectedStockoutsCount is number);
    }

    // --- Diagnostic Healthcheck ---
    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Collection: Users ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSelf(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSelf(userId) && isValidUser(incoming()) && (
        incoming().role in ['hospital_logistics_lead', 'clinical_pharmacist', 'supply_analyst'] || isAdmin()
      );
      allow update: if isValidId(userId) && isSelf(userId) && isValidUser(incoming()) && (
        isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastLoginAt', 'assignedHospitalId'])
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- Collection: Audit Logs (Immutable append-only) ---
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isValidId(logId) && isSignedIn() && isValidAuditLog(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if false; // Strict immutability
    }

    // --- Collection: Mutual-Aid Redististributions ---
    match /redistributions/{transferId} {
      allow get: if isValidId(transferId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(transferId) && isSignedIn() && isValidRedistribution(incoming());
      allow update: if isValidId(transferId) && isSignedIn() && isValidRedistribution(incoming()) && (
        isAdmin() || (
          existing().status != 'DELIVERED' && existing().status != 'CANCELLED' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedBy', 'updatedAt'])
        )
      );
      allow delete: if isValidId(transferId) && isAdmin();
    }

    // --- Collection: Crisis Events ---
    match /crisis_events/{scenarioId} {
      allow get: if isValidId(scenarioId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(scenarioId) && isSignedIn() && isValidCrisisEvent(incoming());
      allow update, delete: if isValidId(scenarioId) && isAdmin();
    }

    // --- Collection: Admins (Bootstrap registry) ---
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // --- Collection: Real Datasets ---
    match /real_datasets/{datasetId} {
      allow read, write: if isSignedIn();
    }
  }
}
